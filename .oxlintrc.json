{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": ["src/**/*.{ts,svelte}"],
      "excludeFiles": [
        "src/**/*.server.*",
        "src/**/*.remote.ts",
        "src/lib/server/**",
        "src/routes/**/+server.ts"
      ],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              {
                "name": "Deno",
                "message": "Deno APIs are unavailable in client-side code."
              }
            ],
            "checkGlobalObject": true
          }
        ]
      }
    }
  ]
}
